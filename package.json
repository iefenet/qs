{
  "name": "lite-qs",
  "version": "1.0.0",
  "description": "极简、零依赖、跨平台的 query string 工具库（parse / stringify），可用于微信小程序、uni-app（含非 H5 端）、Node.js 与浏览器 H5。",
  "main": "dist/lite-qs.cjs",
  "module": "dist/lite-qs.mjs",
  "unpkg": "dist/lite-qs.min.js",
  "jsdelivr": "dist/lite-qs.min.js",
  "miniprogram": "dist/lite-qs.cjs",
  "homepage":"www.iefe.net",
  "exports": {
    ".": {
      "import": "./dist/lite-qs.mjs",
      "require": "./dist/lite-qs.cjs",
      "default": "./dist/lite-qs.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node test/index.test.mjs && node test/dist.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "querystring",
    "query-string",
    "qs",
    "url",
    "parse",
    "stringify",
    "miniprogram",
    "uni-app"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
